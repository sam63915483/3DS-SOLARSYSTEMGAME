; Atmosphere shell shader. The same shell is drawn from both sides:
;   seen from outside (n.v > 0): a soft band, alpha = 0.72 * 4 d (1 - d), d = n.v
;   seen from inside  (n.v < 0): the sky itself, alpha = 0.95
; both scaled by daylight = clamp((n.sun + 0.15) * 3), the vertex alpha and params.x.

.fvec projection[4], modelView[4], sundir, params   ; params.x = alpha scale

.constf myconst(0.0, 1.0, -1.0, 0.5)
.constf inv255(0.00392156862745, 3.0, 0.15, 4.0)
.constf c2(1000.0, 0.95, 0.72, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias innrm v1
.alias incol v2
.alias intex v3

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * inpos
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex

	; n = normalised view-space normal
	dp3 r14.x, modelView[0], innrm
	dp3 r14.y, modelView[1], innrm
	dp3 r14.z, modelView[2], innrm
	dp3 r6.x, r14, r14
	rsq r6.x, r6.x
	mul r14.xyz, r14.xyz, r6.x

	; v = normalised direction from the vertex to the camera
	mov r5, -r1
	dp3 r6.x, r5, r5
	rsq r6.x, r6.x
	mul r5.xyz, r5.xyz, r6.x

	; d = n.v (signed), |d|
	dp3 r7.x, r14, r5
	max r7.z, r7.x, -r7.x

	; outside band = 0.72 * 4 |d| (1 - |d|)
	add r7.y, ones, -r7.z
	mul r7.y, r7.y, r7.z
	mul r7.y, inv255.wwww, r7.y
	mul r7.y, c2.zzzz, r7.y

	; inside weight = clamp(-d * 1000, 0, 1): 1 when we look at the shell from within
	mul r10.x, c2.xxxx, -r7.x
	max r10.x, zeros, r10.x
	min r10.x, ones, r10.x

	; alpha shape = inside * 0.95 + (1 - inside) * band
	mul r10.y, c2.yyyy, r10.x
	add r10.z, ones, -r10.x
	mul r10.z, r10.z, r7.y
	add r7.y, r10.y, r10.z

	; daylight = clamp((n.sun + 0.15) * 3, 0, 1)
	dp3 r8.x, sundir, r14
	add r8.x, inv255.zzzz, r8.x
	mul r8.x, inv255.yyyy, r8.x
	max r8.x, zeros, r8.x
	min r8.x, ones, r8.x

	mul r9, inv255.xxxx, incol
	mul r9.w, r9.w, r7.y
	mul r9.w, r9.w, r8.x
	mul r9.w, params.x, r9.w
	mov outclr, r9
	end
.end
